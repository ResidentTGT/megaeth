{
  "name": "@megaeth-leaderboard/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc -p tsconfig.json && vite build",
